{
  "manifest_version": 3,
  "name": "VGC Tooltips",
  "version": "1.4.0",
  "description": "Hover over Pokemon, moves, items, abilities, and Stat Alignments on Pokemon Showdown, PokePaste, and Limitless to see their VGC data.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vgc-tooltips@pizzacatz.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://replay.pokemonshowdown.com/*",
        "*://play.pokemonshowdown.com/*",
        "*://pokepast.es/*",
        "*://www.pokepast.es/*",
        "*://play.limitlesstcg.com/*",
        "*://limitlessvgc.com/*",
        "*://www.limitlessvgc.com/*",
        "*://standings.limitlessvgc.com/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pokemon.json",
        "moves.json",
        "items.json",
        "abilities.json",
        "natures.json"
      ],
      "matches": [
        "*://replay.pokemonshowdown.com/*",
        "*://play.pokemonshowdown.com/*",
        "*://pokepast.es/*",
        "*://www.pokepast.es/*",
        "*://play.limitlesstcg.com/*",
        "*://limitlessvgc.com/*",
        "*://www.limitlessvgc.com/*",
        "*://standings.limitlessvgc.com/*",
        "file:///*"
      ]
    }
  ]
}
