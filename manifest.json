{
  "manifest_version": 3,
  "name": "Showdown Tooltips",
  "version": "1.1",
  "description": "Hover over Pokemon, moves, items, and abilities on Pokemon Showdown, PokePaste, and Limitless to see their VGC stats.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://replay.pokemonshowdown.com/*",
        "*://play.pokemonshowdown.com/*",
        "*://pokepast.es/*",
        "*://www.pokepast.es/*",
        "*://play.limitlesstcg.com/*",
        "*://limitlessvgc.com/*",
        "*://www.limitlessvgc.com/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pokemon.json",
        "moves.json",
        "items.json",
        "abilities.json"
      ],
      "matches": [
        "*://replay.pokemonshowdown.com/*",
        "*://play.pokemonshowdown.com/*",
        "*://pokepast.es/*",
        "*://www.pokepast.es/*",
        "*://play.limitlesstcg.com/*",
        "*://limitlessvgc.com/*",
        "*://www.limitlessvgc.com/*",
        "file:///*"
      ]
    }
  ]
}